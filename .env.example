# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Railway auto-injects this when you add a DB)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Port the server listens on (Railway injects this automatically)
PORT=3000

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Secret salt used in password hashing — set to any long random string
# (Changing this invalidates all existing passwords)
AUTH_SALT=motohippi_change_me_in_production

# ─── CORS ─────────────────────────────────────────────────────────────────────

# Your deployed frontend URL(s), comma-separated
# e.g. https://motohippi.vercel.app,https://motohippi.com
FRONTEND_URL=https://your-frontend.vercel.app

# ─── Optional ─────────────────────────────────────────────────────────────────

# Node environment
NODE_ENV=production

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Google OAuth (optional — skip if not using Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SendGrid (optional — OTP emails; falls back to console.log without it)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@motohippi.com
